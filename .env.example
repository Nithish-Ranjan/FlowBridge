# FlowBridge Environment Configuration
# Copy this file to .env and fill in real local/environment values before running.
# NEVER commit .env or real database/HMAC secrets.

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string (pg.Pool)
# Example local setup: postgresql://postgres:postgres@localhost:5432/flowbridge
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flowbridge
PG_POOL_MAX=10
PG_SSL=false

# Server-side HMAC keys (use 32+ random hex/base64 characters in real deployments)
IDENTIFIER_HMAC_SECRET=replace-with-32-plus-char-random-hmac-key-for-payer-identifiers
TX_FINGERPRINT_SECRET=replace-with-32-plus-char-random-hmac-key-for-tx-fingerprints

# Frontend API URL (Vite)
VITE_API_BASE_URL=http://localhost:4000/api/v1

